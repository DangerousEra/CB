

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }} beauty-password-section{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  <div
    class="border-style"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% render 'background-media',
      background_media: section.settings.background_media,
      background_video: section.settings.video,
      background_video_position: section.settings.video_position,
      background_image: section.settings.background_image,
      background_image_position: section.settings.background_image_position
    %}

    <div class="beauty-password-orb beauty-password-orb--one" aria-hidden="true"></div>
    <div class="beauty-password-orb beauty-password-orb--two" aria-hidden="true"></div>
    <div class="beauty-password-signature" aria-hidden="true">
      <span>CHINUP</span>
      <i>Beauty, in your own ritual.</i>
    </div>
    <button class="beauty-password-access" type="button" on:click="#password-form/showDialog">Store access</button>
    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        section-content-wrapper
        {% if section.settings.vertical_on_mobile %} mobile-column{% endif %}
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {%  render 'spacing-style', settings: section.settings %}
      "
      data-testid="section-content"
    >
      {% content_for 'blocks' %}

      {%- if shop.password_message != blank -%}
        <div class="password-content">
          {{ shop.password_message }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-password {
    flex-grow: 1;
    display: flex;
  }

  .password-content {
    text-align: center;
  }

  .beauty-password-section {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: #f8e9e4;
    position: relative;
  }

  .beauty-password-section > .border-style {
    display: flex;
    width: 100%;
    border: 0 !important;
    position: relative;
    background: linear-gradient(115deg, #fff8f5 0%, #fff1ee 53%, #f1d4cc 100%);
  }

  .beauty-password-section .section-content-wrapper {
    width: min(100% - 40px, 610px);
    margin: auto 12% auto auto;
    padding: clamp(62px, 8vw, 106px) clamp(26px, 6vw, 76px) !important;
    border: 1px solid rgb(23 23 23 / 9%);
    background: rgb(255 255 255 / 74%);
    box-shadow: 0 28px 90px rgb(110 68 57 / 13%);
    backdrop-filter: blur(10px);
    text-align: center;
    z-index: 1;
  }

  .beauty-password-section .section-content-wrapper > * { text-align: center; }

  .beauty-password-section .section-content-wrapper > :first-child {
    margin-bottom: 22px;
  }

  .beauty-password-section h1 {
    margin: 0;
    color: #171717;
    font-family: var(--font-heading--family, Arial, sans-serif);
    font-size: clamp(45px, 4.7vw, 68px);
    font-weight: 500;
    letter-spacing: -.06em;
    line-height: 1;
  }

  .beauty-password-section .rte { max-width: 390px; margin-inline: auto; color: #5e514d; font-size: 15px; line-height: 1.72; }
  .beauty-password-section .email-signup { width: min(100%, 400px) !important; margin: 8px auto 0; }
  .beauty-password-section .email-signup input { background: #fff !important; }
  .beauty-password-section .button { min-height: 48px; border-radius: 8px !important; letter-spacing: .07em; text-transform: uppercase; }

  .beauty-password-access {
    position: absolute;
    top: 29px;
    right: 34px;
    z-index: 2;
    padding: 10px 15px;
    border: 1px solid rgb(23 23 23 / 20%);
    border-radius: 999px;
    background: rgb(255 255 255 / 75%);
    color: #171717;
    cursor: pointer;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .beauty-password-orb { position: absolute; border-radius: 50%; filter: blur(1px); }
  .beauty-password-orb--one { width: min(53vw, 720px); aspect-ratio: 1; top: -25%; right: -11%; background: #efc5bb; }
  .beauty-password-orb--two { width: min(35vw, 490px); aspect-ratio: 1; bottom: -21%; left: -9%; border: 1px solid #e3b5a9; background: #fde3dc; }
  .beauty-password-signature { position: absolute; left: clamp(32px, 8vw, 140px); bottom: clamp(45px, 10vh, 110px); z-index: 1; max-width: 275px; color: #372923; }
  .beauty-password-signature span { display: block; font-size: clamp(36px, 4vw, 62px); font-weight: 750; letter-spacing: -.1em; line-height: .85; }
  .beauty-password-signature i { display: block; margin-top: 22px; font-family: Georgia,serif; font-size: 18px; line-height: 1.3; }

  @media screen and (max-width: 749px) {
    .beauty-password-section { min-height: calc(100svh - 58px); background: #f8e9e4; }
    .beauty-password-section > .border-style { min-height: calc(100svh - 58px); align-items: flex-end; background: linear-gradient(160deg, #f7ddd6 0%, #fff2ed 48%, #f5e4df 100%); }
    .beauty-password-section .section-content-wrapper { width: calc(100% - 32px); margin: 0 16px 18px; padding: 46px 22px 35px !important; border-radius: 16px; background: rgb(255 253 252 / 88%); box-shadow: 0 18px 48px rgb(104 65 56 / 13%); }
    .beauty-password-section h1 { font-size: clamp(39px, 11vw, 50px); line-height: .98; }
    .beauty-password-section .rte { max-width: 310px; font-size: 14px; line-height: 1.62; }
    .beauty-password-section .email-signup { margin-top: 16px; }
    .beauty-password-section .email-signup input { min-height: 47px; }
    .beauty-password-section .button { width: 100%; min-height: 48px; }
    .beauty-password-access { top: 18px; right: 18px; padding: 9px 13px; font-size: 10px; }
    .beauty-password-signature { display: block; top: 71px; bottom: auto; left: 24px; max-width: 220px; }
    .beauty-password-signature span { font-size: 36px; letter-spacing: -.09em; }
    .beauty-password-signature i { margin-top: 12px; color: #74594f; font-size: 15px; }
    .beauty-password-orb--one { width: 82vw; top: 17%; right: -38%; background: #edbcb1; opacity: .74; }
    .beauty-password-orb--two { width: 72vw; bottom: 30%; left: -44%; opacity: .65; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.section",
  "class": "section-wrapper section-password",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ section.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.background_media == 'none' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "fit",
          "label": "t:options.fit"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
